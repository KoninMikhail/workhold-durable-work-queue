{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "bd631d155155b7fe5e7e499c943e9c5091f906e1",
  "release-type": "simple",
  "initial-version": "1.0.0",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "separate-pull-requests": false,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "security", "section": "Security" },
    { "type": "build", "section": "Build" },
    { "type": "refactor", "section": "Code Refactoring" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Miscellaneous", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true }
  ],
  "packages": {
    ".": {
      "component": "workhold",
      "include-component-in-tag": false,
      "exclude-paths": [
        "packages",
        "tests",
        "tools",
        "benchmarks",
        "docs",
        ".github",
        ".cursor",
        ".planning"
      ],
      "extra-files": [
        {
          "type": "toml",
          "path": "pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "generic",
          "path": "src/workhold/__init__.py"
        }
      ]
    },
    "packages": {
      "component": "workhold-clients",
      "include-component-in-tag": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "workhold-client-core/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "workhold-producer/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "workhold-consumer/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "workhold-admin/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "generic",
          "path": "workhold-client-core/src/_workhold_client_core/__init__.py"
        },
        {
          "type": "generic",
          "path": "workhold-producer/src/workhold_producer/__init__.py"
        },
        {
          "type": "generic",
          "path": "workhold-consumer/src/workhold_consumer/__init__.py"
        },
        {
          "type": "generic",
          "path": "workhold-admin/src/workhold_admin/__init__.py"
        }
      ]
    }
  }
}
