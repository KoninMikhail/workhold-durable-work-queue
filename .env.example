# Queue deployment environment contract (non-secret names + safe defaults).
# Copy to `.env` for local Compose. Never commit real credentials or certificates.

# --- Database ---
DATABASE_URL=postgresql+psycopg://queue:queue@localhost:5432/queue
# Image entrypoint alternative (exclusive with DATABASE_URL): absolute secret file path.
# DATABASE_URL_FILE=/run/secrets/database_url
# Optional Alembic / readiness schema override (defaults to PostgreSQL search_path).
# QUEUE_SCHEMA=public
# ALEMBIC_VERSION_TABLE_SCHEMA=public

# --- Environment / transport (SEC-04) ---
# development | production
QUEUE_ENVIRONMENT=development
# plaintext_public is development-only.
# production requires direct_tls or trusted_private_tls_termination.
QUEUE_LISTENER_TLS_MODE=plaintext_public
# QUEUE_LISTENER_TLS_MODE=direct_tls
# QUEUE_LISTENER_TLS_MODE=trusted_private_tls_termination

# --- PostgreSQL connection budget (DEP-03) ---
# usable = max - reserved; sum(role replica_ceiling × pool_ceiling) must fit.
QUEUE_POSTGRES_MAX_CONNECTIONS=100
QUEUE_POSTGRES_RESERVED_CONNECTIONS=10
QUEUE_API_REPLICA_CEILING=1
QUEUE_API_POOL_CEILING=4
QUEUE_ADMIN_REPLICA_CEILING=1
QUEUE_ADMIN_POOL_CEILING=2
QUEUE_MIGRATE_REPLICA_CEILING=1
QUEUE_MIGRATE_POOL_CEILING=2
QUEUE_APPLY_REPLICA_CEILING=1
QUEUE_APPLY_POOL_CEILING=2
QUEUE_MAINTAIN_REPLICA_CEILING=1
QUEUE_MAINTAIN_POOL_CEILING=2
QUEUE_RELAY_REPLICA_CEILING=1
QUEUE_RELAY_POOL_CEILING=2
# Optional per-role timeouts (seconds):
# QUEUE_API_POOL_ACQUISITION_TIMEOUT_SECONDS=5
# QUEUE_API_STATEMENT_TIMEOUT_SECONDS=30

# --- API listeners (application published; admin private / unpublished) ---
QUEUE_APPLICATION_HOST=0.0.0.0
QUEUE_APPLICATION_PORT=8080
QUEUE_ADMIN_HOST=0.0.0.0
QUEUE_ADMIN_PORT=8081

# --- Shutdown / readiness horizon ---
QUEUE_SHUTDOWN_GRACE_SECONDS=5
QUEUE_PARTITION_PREMAKE_DAYS=30
QUEUE_PAYLOAD_RETENTION_DAYS=90
# Client scheduling horizon in seconds (WORK-15). Default and max 86400; range 0..86400.
# QUEUE_SCHEDULE_HORIZON_SECONDS=86400

# --- Claim long polling (Phase 20.1 WORK-17 / API-09) ---
# Live capability advertises long_polling=true / max_wait_seconds=20 after Plan 06.
# Production reverse-proxy upstream idle/response timeout must be >= 30 seconds
# (server max 20 + 10 s margin) before enabling this capability in a deployment.
# Deployment max wait for positive wait_seconds (0..20 inclusive).
QUEUE_CLAIM_MAX_WAIT_SECONDS=20
# Authoritative reconciliation interval when wake hints are missed (seconds).
QUEUE_CLAIM_WAIT_FALLBACK_SECONDS=1.0
# Request cancellation / API shutdown probe interval (seconds).
QUEUE_CLAIM_CANCELLATION_PROBE_SECONDS=0.25
# Max outstanding long polls per API replica (HTTP waiter semaphore).
QUEUE_CLAIM_MAX_OUTSTANDING_WAITS=64

# --- API service principals (recommended production contract) ---
# The whole JSON manifest is a secret. It defines distinct PRODUCER, WORKER,
# OBSERVER and ADMIN principals, exact queue scopes and overlapping generations.
# In the image, mount it and set only the _FILE sibling; host/uv uses the
# unsuffixed variable. NAME and NAME_FILE are exclusive.
# QUEUE_API_PRINCIPALS_MANIFEST_FILE=/run/secrets/queue_api_principals.json
# QUEUE_API_PRINCIPALS_MANIFEST={"schema_version":1,"principals":[...]}
#
# A non-blank manifest is exclusive with the legacy token variables below:
# legacy current/previous tokens are ignored, not merged. Invalid manifests fail
# startup. See docs/08-examples/service-principal-manifest.example.json.
#
# --- Legacy API ADMIN credential generations (development compatibility) ---
# Accepted only when no non-blank principal manifest is configured. These tokens
# authenticate as ADMIN and cannot enqueue, claim, heartbeat, complete or fail.
# NAME and NAME_FILE are exclusive. *_FILE is the image-entrypoint contract;
# host/uv run keeps using NAME directly.
QUEUE_API_PRINCIPAL_ID=api-dev
QUEUE_API_GENERATION_ID=current
QUEUE_API_BEARER_TOKEN=replace-me-current
# QUEUE_API_BEARER_TOKEN_FILE=/run/secrets/queue_api_bearer_token
QUEUE_API_PREVIOUS_GENERATION_ID=previous
QUEUE_API_BEARER_TOKEN_PREVIOUS=replace-me-previous
# QUEUE_API_BEARER_TOKEN_PREVIOUS_FILE=/run/secrets/queue_api_bearer_token_previous

# --- Migrate / maintain / apply ---
# QUEUE_MIGRATE_LOCK_DEADLINE_SECONDS=30
# QUEUE_APPLY_LOCK_DEADLINE_SECONDS=30
# QUEUE_CATALOG_PATH is apply-role env only (absolute mounted file path; not image-baked).

# --- Optional error reporting (OPS-10; GlitchTip via Sentry protocol) ---
# Non-empty SENTRY_DSN is the only enablement switch. Unset/empty leaves SDK off.
# SENTRY_DSN and SENTRY_DSN_FILE are exclusive (container entrypoint; DEP-05).
# Host `uv run queue` uses SENTRY_DSN only. Never commit a real DSN.
# SENTRY_DSN=
# SENTRY_DSN_FILE=
